msgid "Layout"
msgstr "布局"

msgid "Brand name"
msgstr "品牌名称"

msgid "Brand subtitle"
msgstr "品牌副标题"

msgid "Use router hostname"
msgstr "使用路由器主机名"

msgid "Leave empty to display the router hostname."
msgstr "留空时显示路由器主机名。"

msgid "Brand logo URL"
msgstr "品牌 Logo URL"

msgid "Use an absolute web path or an HTTP(S) URL. Leave empty to use the built-in logo."
msgstr "填写绝对 Web 路径或 HTTP(S) URL；留空使用内置 Logo。"

msgid "Footer text"
msgstr "页脚文字"

msgid "Leave empty to use the brand name."
msgstr "留空时使用品牌名称。"

msgid "Login title"
msgstr "登录页标题"

